{
  "nodeModulesDir": "auto",
  "test": {
    "exclude": ["src/components/ui/__tests__/", "e2e/"]
  },
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "serve": "deno run -A npm:vite preview",
    "tauri": "deno run -A npm:@tauri-apps/cli",
    "test": "deno test --allow-read --allow-env && deno run -A npm:vitest run",
    "test:ui": "deno run -A npm:vitest run",
    "test:e2e": "deno run -A npm:playwright test --config=e2e/playwright.config.ts"
  }
}
